### Cap robot configuration
#
# Copy to the repository root as `.env` — both services read it:
#   cp deploy/env/.env.example .env
#
# Everything has a working default; the only value you are likely to need is a
# speech-to-text provider, and only until the local model is installed.

## ── Hardware ────────────────────────────────────────────────────────────────

# Run without any hardware (development machines). On the robot, leave unset.
#CAP_HW_MOCK=1

# ESP32 driving the eyes. The board enumerates as /dev/ttyUSB0 with a CH340.
CAP_SERIAL_PORT=/dev/ttyUSB0
CAP_SERIAL_BAUD=115200

# Microphone, as verified during bring-up (`arecord -L` lists the devices).
CAP_MIC_DEVICE=plughw:CARD=Device,DEV=0
# Speaker; `default` follows the system's own choice.
CAP_SPEAKER_DEVICE=default

# Face detection network, packed on the Pi with imx500-package. The default is
# derived from the repository root, so this only needs setting if you moved it.
#CAP_FACE_MODEL=/home/cap/cap-robot/modules/ai-camera/models/yolov8n-face-lindevs_imx_model/rpk/network.rpk

# Flip the camera image when Cap is mounted upside down. Also settable from the
# robot's own settings screen, which is easier: you can see the preview.
CAP_CAMERA_VFLIP=false
CAP_CAMERA_FPS=15

# Follow faces with the eyes as soon as the daemon starts.
CAP_TRACKING_AUTOSTART=true

# Longest voice recording, in seconds.
CAP_MAX_RECORD_SECONDS=120

## ── Voice ───────────────────────────────────────────────────────────────────

# Speech synthesis runs on the robot: Cap keeps its voice with no network.
# `supertonic` on the Pi, `mock` for a silent stand-in.
CAP_TTS=supertonic
SUPERTONIC_VOICE=M1
SUPERTONIC_SPEED=1.05
SUPERTONIC_TOTAL_STEPS=8
SUPERTONIC_CACHE_DIR=/home/cap/.cache/supertonic
CAP_TTS_LANG=fr

## ── Language model ──────────────────────────────────────────────────────────

# ollama (local, default) or scaleway (hosted fallback).
CAP_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://LLM:11434/v1
CAP_LLM_MODEL=mistral-small3.2:24b

# Only needed with CAP_LLM_PROVIDER=scaleway or CAP_STT_PROVIDER=scaleway.
#SCW_SECRET_KEY=
#SCW_LLM_MODEL=mistral/mistral-small-3.2-24b-instruct-2506:fp8

## ── Speech to text ──────────────────────────────────────────────────────────

# local | ovh | scaleway | mock
#
# `mock` is the default on purpose: with nothing configured the robot simulates
# transcription and says so, rather than sending a recording of someone's voice
# to a provider nobody chose.
CAP_STT_PROVIDER=mock

# When the local speech model is installed, point this at it — it only has to
# speak the OpenAI transcription API.
#CAP_STT_BASE_URL=http://LLM:11434/v1
#CAP_STT_MODEL=whisper-large-v3

# OVHcloud AI Endpoints.
#OVH_AI_ENDPOINTS_ACCESS_TOKEN=
#OVH_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

## ── Flots ───────────────────────────────────────────────────────────────────

# Which Flots the robot pairs with. Staging is reachable from anywhere.
FLOTS_MCP_BASE=https://api-staging.flots.app

# Where the OAuth consent comes back to. Use the robot's own address if you
# want to pair from a laptop or a phone on the same network.
CAP_PUBLIC_URL=http://localhost:3000

## ── Interface ───────────────────────────────────────────────────────────────

CAP_LOCALE=fr
CAP_TIMEZONE=Europe/Paris
# When Cap reads the day out loud.
CAP_BRIEFING_TIME=08:00

# Where alarms, the day cache and the Flots token are kept.
CAP_DATA_DIR=/home/cap/.cap

# Ports. The daemon stays on localhost; the interface is what the panel opens.
CAPD_HOST=127.0.0.1
CAPD_PORT=8790
CAPD_URL=http://127.0.0.1:8790

LOG_LEVEL=INFO
